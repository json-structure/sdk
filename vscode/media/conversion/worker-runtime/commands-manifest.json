      ],
      "options": [
        {
          "name": "dialect",
          "type": "string",
          "description": "SQL dialect used by the s2sql exporter.",
          "default": "postgres",
          "allowedValues": [
            "mysql",
            "mariadb",
            "postgres",
            "sqlserver",
            "oracle",
            "sqlite",
            "bigquery",
            "snowflake",
            "redshift",
            "db2"
          ]
        },
        {
          "name": "namespace",
          "type": "string",
          "description": "Namespace for generated declarations.",
          "default": ""
        },
        {
          "name": "root_class_name",
          "type": "string",
          "description": "Root class name used by the j2s converter.",
          "default": "document"
        },
        {
          "name": "type_name",
          "type": "string",
          "description": "Root type name used by inference converters.",
          "default": "Document"
        },
        {
          "name": "base_id",
          "type": "string",
          "description": "Base URI used for inferred schema identity.",
          "default": "https://example.com/"
        },
        {
          "name": "sample_size",
          "type": "number",
          "description": "Maximum number of samples (0 means all).",
          "default": 0,
          "minimum": 0,
          "maximum": 100000
        },
        {
          "name": "choice_depth",
          "type": "number",
          "description": "Maximum nested choice inference depth.",
          "default": 1,
          "minimum": 1,
          "maximum": 64
        },
        {
          "name": "infer_choices",
          "type": "boolean",
          "description": "Infer discriminated choices from samples.",
          "default": false
        },
        {
          "name": "infer_enums",
          "type": "boolean",
          "description": "Infer enums from repeated values.",
          "default": false
        },
        {
          "name": "preserve_composition",
          "type": "boolean",
          "description": "Preserve composition keywords where supported.",
          "default": false
        },
        {
          "name": "detect_inheritance",
          "type": "boolean",
          "description": "Detect inheritance patterns in JSON Schema.",
          "default": true
        },
        {
          "name": "detect_discriminators",
          "type": "boolean",
          "description": "Detect discriminator patterns.",
          "default": true
        },
        {
          "name": "lift_inline_schemas",
          "type": "boolean",
          "description": "Lift inline OpenAPI schemas into definitions.",
          "default": false
        },
        {
          "name": "convert_empty_objects_to_maps",
          "type": "boolean",
          "description": "Convert empty JSON Schema objects to maps.",
          "default": true
        },
        {
          "name": "naming",
          "type": "string",
          "description": "Type naming convention.",
          "default": "default",
          "allowedValues": [
            "snake",
            "camel",
            "pascal",
            "default"
          ]
        },
        {
          "name": "avro_encoding",
          "type": "boolean",
          "description": "Enable Avro encoding for unions.",
          "default": false
        },
        {
          "name": "kusto_uri",
          "type": "string",
          "description": "Kusto cluster URI.",
          "default": ""
        },
        {
          "name": "kusto_database",
          "type": "string",
          "description": "Kusto database name.",
          "default": ""
        },
        {
          "name": "table_name",
          "type": "string",
          "description": "Kusto table name.",
          "default": ""
        },
        {
          "name": "emit_cloudevents",
          "type": "boolean",
          "description": "Emit CloudEvents declarations.",
          "default": false
        },
        {
          "name": "emit_xregistry",
          "type": "boolean",
          "description": "Emit an xRegistry manifest.",
          "default": false
        },
        {
          "name": "message_type",
          "type": "string",
          "description": "Protocol Buffers message selected as the imported root.",
          "default": ""
        },
        {
          "name": "proto_root",
          "type": "string",
          "description": "Root directory used to resolve Protocol Buffers imports.",
          "default": ""
        },
        {
          "name": "connection_string",
          "type": "string",
          "description": "Database connection string used for SQL schema import.",
          "default": ""
        },
        {
          "name": "username",
          "type": "string",
          "description": "Optional database user name.",
          "default": ""
        },
        {
          "name": "password",
          "type": "string",
          "description": "Optional database password.",
          "default": ""
        },
        {
          "name": "database",
          "type": "string",
          "description": "Optional database name.",
          "default": ""
        },
        {
          "name": "infer_json",
          "type": "boolean",
          "description": "Infer structures stored in JSON columns.",
          "default": false
        },
        {
          "name": "infer_xml",
          "type": "boolean",
          "description": "Infer structures stored in XML columns.",
          "default": false
        },
        {
          "name": "emit_cloudevents_columns",
          "type": "boolean",
          "description": "Include CloudEvents metadata columns in generated database schemas.",
          "default": false
        },
        {
          "name": "record_type",
          "type": "string",
          "description": "SurrealQL record type used for generated declarations.",
          "default": ""
        }
      ]
    }
