{
  "name": "@json-structure/sdk",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript SDK for validating JSON documents against JSON Structure schemas",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:runtime": "node --test tests/runtime-compatibility.cjs",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "json",
    "schema",
    "validation",
    "json-structure",
    "typescript"
  ],
  "author": "JSON Structure Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/json-structure/sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/json-structure/sdk/issues"
  },
  "homepage": "https://json-structure.org",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "tsup": "^9.0.0",
    "typescript": "^5.3.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "minimatch@>=7 <11": "^11.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
