{
  "schemaVersion": 1,
  "converters": [
    {
      "id": "jsonschema",
      "displayName": "JSON Schema Converter",
      "version": "1.0.0-node",
      "sourceFormats": [
        "json-schema",
        "json"
      ],
      "targetFormats": [
        "json-structure"
      ],
      "options": [
        {
          "name": "rootName",
          "type": "string",
          "description": "Root declaration name used for imported anonymous schemas.",
          "default": "Root"
        },
        {
          "name": "preserveUnknownKeywords",
          "type": "boolean",
          "description": "Preserve unsupported JSON Schema keywords as x-json-schema-* annotations.",
          "default": false
        }
      ]
    },
    {
      "id": "avro",
      "displayName": "Avro Converter",
      "version": "1.0.0-node",
      "sourceFormats": [
        "avro",
        "json"
      ],
      "targetFormats": [
        "json-structure"
      ],
      "options": [
        {
          "name": "rootName",
          "type": "string",
          "description": "Root declaration name for unnamed Avro schemas.",
          "default": "Root"
        },
        {
          "name": "preserveLogicalType",
          "type": "boolean",
          "description": "Carry Avro logicalType metadata into conversion warnings.",
          "default": true
        },
        {
          "name": "mode",
          "type": "string",
          "description": "Emit compact wire metadata or the full normative annotation set.",
          "default": "compact",
          "allowedValues": [
            "compact",
            "full"
          ]
        },
        {
          "name": "uses",
          "type": "string-list",
          "description": "Ordered add-in names selected from the document $offers map.",
          "default": []
        },
        {
          "name": "additional_properties",
          "type": "string",
          "description": "Ignore open records with a warning or reject them during Avro export.",
          "default": "ignore",
          "allowedValues": [
            "ignore",
            "error"
          ]
        },
        {
          "name": "emit_doc",
          "type": "boolean",
          "description": "Emit Avro doc attributes from JSON Structure descriptions.",
          "default": true
        }
      ]
    },
    {
      "id": "protobuf",
      "displayName": "Protocol Buffers Generator",
      "version": "1.0.0-node",
      "sourceFormats": [
        "json-structure"
      ],
      "targetFormats": [
        "protobuf"
      ],
      "options": [
        {
          "name": "uses",
          "type": "string-list",
          "description": "Ordered add-in names selected from the document $offers map.",
          "default": []
        },
        {
          "name": "additional_properties",
          "type": "string",
          "description": "Ignore open records with a warning or reject them during Protobuf export.",
          "default": "ignore",
          "allowedValues": [
            "ignore",
            "error"
          ]
        },
        {
          "name": "emit_comments",
          "type": "boolean",
          "description": "Emit leading comments from JSON Structure descriptions and defaults.",
          "default": true
        },
        {
          "name": "numbers",
          "type": "string",
          "description": "Optional version 2 field-number lock as JSON.",
          "default": ""
        }
      ]
    },
    {
      "id": "structurize-cli",
      "displayName": "Structurize CLI",
      "version": "external",
      "sourceFormats": [
        "json-structure"
      ],
      "targetFormats": [
        "asn1",
        "flatbuffers",
        "kusto",
        "sql",
        "iceberg",
        "parquet",
        "tmsl",
        "csharp",
        "python",
        "cpp",
        "csv-schema",
        "rust",
        "typescript",
        "java",
        "javascript",
        "go",
        "graphql",
        "data-package",
        "cassandra",
        "jtd",
        "xsd",
        "cddl",
        "markdown",
        "cue",
        "thrift",
        "smithy",
        "capnp",
        "raml"
      ],
      "options": [
        {
          "name": "dialect",
          "type": "string",
          "description": "SQL dialect used by the s2sql exporter.",
          "default": "postgres",
          "allowedValues": [
            "mysql",
            "mariadb",
            "postgres",
            "sqlserver",
            "oracle",
            "sqlite",
            "bigquery",
            "snowflake",
            "redshift",
            "db2"
          ]
        }
      ]
    }
  ],
