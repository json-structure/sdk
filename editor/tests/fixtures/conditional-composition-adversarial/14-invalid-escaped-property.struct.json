{
  "$schema": "https://json-structure.org/meta/validation/v0/#",
  "$id": "https://example.test/conditional/invalid-escaped-property",
  "name": "EscapedPropertyLegacyProbe",
  "description": "Intentionally invalid Core identifier; the JSON Pointer manifest entry must escape slash and tilde.",
  "type": "object",
  "properties": {
    "a/b~c": {
      "type": "string",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^alpha"
        },
        {
          "type": "string",
          "pattern": "omega$"
        }
      ],
      "if": {
        "type": "string",
        "minLength": 8
      },
      "then": {
        "not": {
          "type": "string",
          "const": "alphaomega"
        }
      },
      "else": {}
    }
  },
  "required": [
    "a/b~c"
  ],
  "additionalProperties": false
}
