  ],
  "additionalProperties": false,
  "allOf": [],
  "anyOf": [],
  "oneOf": [],
  "if": {
    "type": "object",
    "name": "MarkerCondition",
    "properties": {
      "marker": {
        "type": "string",
        "const": "x"
      }
    },
    "required": [
      "marker"
    ],
    "additionalProperties": true
  },
  "then": {},
  "else": {}
}
