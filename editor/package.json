{
  "name": "@json-structure/editor-foundation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:ui": "tsup src/ui.ts --format esm --dts",
    "build:renderer": "vite build --config vite.config.ts",
    "build:vscode": "vite build --config vite.vscode.config.ts",
    "build:electron": "tsup --config tsup.electron.config.ts",
    "alpha:build": "npm run build:renderer && npm run build:electron",
    "alpha:run": "npm run alpha:build && electron .",
    "alpha:dev": "concurrently --kill-others-on-fail \"vite --config vite.config.ts --host 127.0.0.1\" \"node scripts/dev-electron.mjs\"",
    "alpha:package": "npm run alpha:build && electron-builder",
    "beta:build": "npm run alpha:build && npm run build:vscode",
    "beta:run": "npm run beta:build && electron .",
    "beta:dev": "npm run alpha:dev",
    "release:clean": "node -e \"require('node:fs').rmSync('release',{recursive:true,force:true})\"",
    "beta:package": "npm run beta:build && electron-builder",
    "release:executables": "node scripts/release-integrity.mjs executables release",
    "release:scan": "node scripts/release-integrity.mjs scan release",
    "release:attest": "node scripts/release-integrity.mjs attest release",
    "beta:package:verified": "npm run release:clean && npm run beta:package -- --publish never && npm run release:executables && npm run release:scan && npm run release:attest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage:check": "node scripts/coverage-check.mjs",
    "coverage:generate": "node scripts/generate-coverage.mjs"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "electron": "^41.10.3",
    "electron-builder": "latest",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vite": "latest",
    "vitest": "^4.0.18"
  },
  "main": "dist-electron/main.cjs",
  "exports": {
    "./conversion-types": {
      "types": "./dist/conversion/types.d.ts",
      "import": "./dist/conversion/types.js",
      "require": "./dist/conversion/types.cjs"
    },
    "./library-host-runtime": {
      "types": "./dist/libraries/host-runtime.d.ts",
      "import": "./dist/libraries/host-runtime.js",
      "require": "./dist/libraries/host-runtime.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "conversion-types": [
        "dist/conversion/types.d.ts"
      ],
      "library-host-runtime": [
        "dist/libraries/host-runtime.d.ts"
      ]
    }
  },
  "build": {
    "appId": "org.json-structure.editor",
    "productName": "JSON Structure Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist/renderer/**",
      "package.json",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "extraResources": [
      {
        "from": "src/conversion/worker-runtime",
        "to": "conversion/worker-runtime"
      },
      {
        "from": "../vscode/test-fixtures/financial-types/schema.struct.json",
        "to": "libraries/financial-types.struct.json"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "monaco-editor": "^0.56.0",
    "re2js": "^2.8.6"
  }
}
