{
  "type": "record",
  "name": "Unspoken",
  "fields": [
    {
      "name": "code",
      "type": "string",
      "annotations": {
        "maxLength": 8,
        "pattern": "^[A-Z]+$"
      }
    },
    {
      "name": "count",
      "type": "int",
      "annotations": {
        "minimum": 1
      }
    }
  ]
}
