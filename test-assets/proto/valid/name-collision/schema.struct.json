{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://example.com/proto/name-collision",
  "$root": "#/definitions/Envelope",
  "definitions": {
    "Envelope": {
      "name": "Envelope",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "payload": {
          "type": "object",
          "properties": { "body": { "type": "string" } },
          "required": ["body"]
        },
        "declared": { "type": { "$ref": "#/definitions/Envelope_payload" } }
      },
      "required": ["id", "payload", "declared"]
    },
    "Envelope_payload": {
      "name": "Envelope_payload",
      "type": "object",
      "properties": { "note": { "type": "string" } },
      "required": ["note"]
    }
  }
}
